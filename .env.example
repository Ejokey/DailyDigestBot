TELEGRAM_BOT_TOKEN=

# LLM provider: 'groq' (cloud, free tier), 'ollama' (local, free), or 'anthropic' (cloud)
LLM_PROVIDER=groq

# Used when LLM_PROVIDER=groq (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Used when LLM_PROVIDER=ollama. Point OLLAMA_MODEL at whatever local model you settle on
# (e.g. qwen2.5:3b, llama3.2:3b, phi3:mini) after pulling it with `ollama pull <model>`.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

DB_PATH=./data/bot.sqlite
EVENING_CHECKIN_TIME=20:00
TIMEZONE=Europe/Moscow
